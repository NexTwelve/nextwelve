{
  "name": "@nextwelve/db",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "tsx --env-file=../../.env src/cli.ts bootstrap",
    "migrate": "tsx --env-file=../../.env src/cli.ts migrate",
    "job-key": "tsx --env-file=../../.env src/cli.ts job-key"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
