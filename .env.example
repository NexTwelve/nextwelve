# Copy to .env (never commit .env). Used by the Node scripts: bootstrap, migrate, provision,
# seed:sample and the tests. The Worker itself reads wrangler.jsonc, .dev.vars and Wrangler secrets.
# Defaults below match docker-compose.yml (trust auth, local use only).

# --- Bootstrap: a role with CREATEROLE. Local: the container superuser.
#     PlanetScale: the connection string the dashboard gives for the default "postgres" role
#     (keep its sslmode parameter). That role bypasses RLS: use it for bootstrap only.
ADMIN_DATABASE_URL=postgres://postgres@localhost:54329/postgres
# Passwords given to epm_owner and epm_app at bootstrap. Required on PlanetScale; ignored by
# local trust auth. Generate with `openssl rand -base64 32`.
EPM_OWNER_PASSWORD=
EPM_APP_PASSWORD=

# --- Migrations and provisioning run as the schema owner.
MIGRATION_DATABASE_URL=postgres://epm_owner@localhost:54329/nextwelve
# --- The API role (row-level security applies). Hyperdrive uses this same role in production;
#     seed:sample connects with it directly.
DATABASE_URL=postgres://epm_app@localhost:54329/nextwelve

# --- Tests create and drop a throwaway database per suite through a superuser connection.
#     Point this at local Postgres only, never at PlanetScale.
NX_TEST_SUPERUSER_URL=postgres://postgres@localhost:54329/postgres
